# =============================================================================
# Ở Đây Nè — environment configuration template
# -----------------------------------------------------------------------------
# Copy to `.env` (root) for `docker compose up`, or export individually before
# `node server/api.mjs`. Never commit a real `.env`.
# =============================================================================

# ---- Networking ----
# Public-facing URL of the deployment. Locks CORS + the CSP `connect-src` in
# production, and is reflected back to the OAuth provider as redirect target.
PUBLIC_URL=https://odayne.example.com

# Internal ports. PORT is the web tier (served behind reverse-proxy / Tunnel).
# API_PORT is the API child reached only through the web tier proxy.
PORT=4174
API_PORT=8788

# Bind host. Inside Docker MUST be 0.0.0.0 so the port-proxy can reach the
# server — binding to 127.0.0.1 inside a container silently fails because
# Docker's userland proxy can't see it.
BIND_HOST=0.0.0.0

# ---- Auth ----
# Real Google OAuth (recommended for production). Leave blank to keep the
# demo provider on (clearly labelled "Chế độ xem trước" in the UI).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://odayne.example.com/

# Demo auth is OFF by default in production. Set to `true` only for local
# preview / staging where you want the "Chế độ xem trước" login path. Leaving
# it on in prod exposes /api/auth/demo, which can mint a session for any
# email a caller supplies.
ALLOW_DEMO_AUTH=false

# Seed demo data is OFF by default. Set to `true` only for local preview so
# you get the Hanoi sample rooms + admin@odayne.local pre-seeded as admin.
# Leaving this on in prod means a brand-new deploy ships with a well-known
# admin email that can be claimed if demo auth is also enabled.
SEED_DEMO_DATA=false

# Shared secret for ops emergencies — lets `/api/admin/*` and the backup
# endpoint accept the `X-Admin-Token` header instead of a logged-in admin
# session. Generate with `openssl rand -hex 32` and store in a secret vault.
ADMIN_TOKEN=

# ---- Image uploads ----
# Cloudinary signed upload (optional, recommended for production). When all
# three are set, file uploads go directly from the browser to Cloudinary's
# edge (saves VPS bandwidth, auto-converts iPhone HEIC, serves WebP/AVIF
# variants). Leave blank to keep files on this VPS at backend/data/uploads/.
#
# Get credentials at https://console.cloudinary.com/  →  Dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder under your Cloudinary account where uploads land. Useful for
# isolating staging from prod. Defaults to "odayne/rooms".
CLOUDINARY_UPLOAD_FOLDER=odayne/rooms

# ---- Database backups ----
# How often (minutes) the API spawns a `db.backup()` snapshot into
# server/data/backups/. Set to 0 to disable the loop.
BACKUP_INTERVAL_MIN=360
# How many snapshots to retain. Older ones are deleted FIFO.
BACKUP_KEEP=10

# Optional: move the SQLite + uploads directory off the project tree (e.g. to
# a mounted volume). Defaults to ./backend/data.
# ODN_DATA_DIR=/var/lib/odayne

# ---- Telegram notifications (optional) ----
# When set, the API broadcasts new viewing appointments and consultation
# requests to the listed Telegram chats. Discover chat ids with:
#   TELEGRAM_BOT_TOKEN=... npm run telegram:chat-ids
# (the helper script prints chat ids without echoing the token).
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids (e.g. "12345,-100123456789"). Negative numbers are
# group chats. Leave blank to skip Telegram notifications.
TELEGRAM_NOTIFY_CHAT_IDS=
